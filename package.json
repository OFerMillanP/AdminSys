{
  "name": "lit-element-starter-js",
  "version": "1.0.0",
  "description": "A simple web component",
  "main": "my-element.js",
  "module": "my-element.js",
  "type": "module",
  "scripts": {
    "lint": "lit-analyzer my-element.js && eslint '**/*.js'",
    "format": "prettier my-element.js test/* --write",
    "docs": "npm run docs:clean && npm run analyze && npm run docs:build && npm run docs:assets && npm run docs:gen",
    "docs:clean": "rimraf docs",
    "docs:gen": "eleventy --config=.eleventy.cjs",
    "docs:gen:watch": "eleventy --config=.eleventy.cjs --watch",
    "docs:build": "rollup -c --file docs/my-element.bundled.js",
    "docs:assets": "cp node_modules/prismjs/themes/prism-okaidia.css docs/",
    "docs:serve": "es-dev-server --root-dir=docs --node-resolve --watch",
    "analyze": "wca analyze \"**/*.js\" --outFile custom-elements.json",
    "serve": "es-dev-server --node-resolve --watch",
    "api": "cd api/api-n && npm run start && cd ../..",
    "start:all:w": "start /b npm run start & start /b npm run api",
    "start": "npm-run-all -p start-server watch-scss",
    "start-server": "es-dev-server --node-resolve --open --watch",
    "watch-scss": "sass --watch scss/styles.scss css/styles.css",
    "test": "karma start karma.conf.cjs",
    "test:watch": "karma start karma.conf.cjs --auto-watch=true --single-run=false",
    "test:update-snapshots": "karma start karma.conf.cjs --update-snapshots",
    "test:prune-snapshots": "karma start karma.conf.cjs --prune-snapshots",
    "checksize": "rollup -c ; cat my-element.bundled.js | gzip -9 | wc -c ; rm my-element.bundled.js",
    "build": "echo \"This is not a TypeScript project, so no need to build.\""
  },
  "keywords": [
    "web-components",
    "lit",
    "javascript"
  ],
  "author": "The Polymer Authors",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@material/mwc-button": "^0.27.0",
    "@material/mwc-formfield": "^0.27.0",
    "@material/mwc-icon": "^0.27.0",
    "@material/mwc-icon-button": "^0.27.0",
    "@material/mwc-tab-bar": "^0.27.0",
    "@material/mwc-textarea": "^0.27.0",
    "@material/mwc-textfield": "^0.27.0",
    "@material/mwc-top-app-bar": "^0.27.0",
    "@open-wc/scoped-elements": "^3.0.6",
    "@vaadin/icon": "^25.1.3",
    "@vaadin/icons": "^4.1.1",
    "@vaadin/login": "^25.1.1",
    "@vaadin/text-field": "^25.1.1",
    "bootstrap": "^5.3.8",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^0.10.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^3.0.1",
    "@commitlint/cli": "^8.0.0",
    "@commitlint/config-conventional": "^8.0.0",
    "@open-wc/eslint-config": "^4.0.0",
    "@open-wc/prettier-config": "^0.1.0",
    "@open-wc/scoped-elements": "^3.0.6",
    "@open-wc/testing": "^2.5.10",
    "@open-wc/testing-karma": "^3.3.11",
    "@rollup/plugin-replace": "^2.3.1",
    "@types/chai": "^4.2.11",
    "@types/mocha": "^7.0.2",
    "@web/dev-server": "^0.4.6",
    "babel-eslint": "^10.1.0",
    "chai": "^4.2.0",
    "deepmerge": "^4.2.2",
    "es-dev-server": "^1.46.1",
    "eslint": "^6.8.0",
    "eslint-import-resolver-webpack": "^0.12.0",
    "eslint-plugin-json": "^2.0.0",
    "eslint-plugin-markdown": "^1.0.0",
    "husky": "^3.0.0",
    "karma": "^4.4.1",
    "karma-chai": "^0.1.0",
    "karma-mocha": "^1.3.0",
    "lint-staged": "^9.0.0",
    "lit-analyzer": "^1.1.9",
    "mocha": "^7.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.0.4",
    "rimraf": "^3.0.2",
    "rollup": "^1.32.1",
    "rollup-plugin-filesize": "^7.0.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-terser": "^5.3.0",
    "sass": "^1.98.0",
    "sinon": "^7.0.0",
    "sort-package-json": "^1.0.0",
    "standard-version": "^7.1.0",
    "stylelint": "12.0.0",
    "stylelint-config-recommended-scss": "^4.0.0",
    "stylelint-config-standard": "^19.0.0",
    "stylelint-scss": "^3.0.0",
    "web-component-analyzer": "^1.0.3"
  }
}
